+# A configured log file is used once, and --log overrides it rather than
+# adding a second appender. --noconf ignores the configured value.
+testLogFileConfigurationAndCliOverride() {
+    skip_if_rpm_testing_off && return
+    local conf=$TMPDIR/poldek-log.conf configured_log=$TMPDIR/configured.log
+    local cli_log=$TMPDIR/cli.log wrapper=$TMPDIR/rpm-wrapper use_sudo=n
+
+    [ -n "$SUDO" ] && use_sudo=y
+    cat > "$conf" <<EOF
+[global]
+log file = $configured_log
+EOF
+    rm -f "$configured_log" "$cli_log"
+
+    cat > "$wrapper" <<EOF
+#!/bin/sh
+printf 'configured\n'
+exec "$(command -v rpm)" "\$@"
+EOF
+    chmod +x "$wrapper"
+
+    build a 1-1
+    $POLDEK --conf "$conf" --cachedir "$CACHEDIR" \
+        -Ouse_sudo=$use_sudo -Odependency_solver=$DEPENDENCY_SOLVER \
+        -Oupgrade_multiple_instances=y --noask \
+        --st dir -s "$REPO" --root "$DESTINATION_REPO" --justdb \
+        --pmcmd "$wrapper" -uv a
+    assertEquals "install with configured log failed" "0" "$?"
+    grep -q " rpm: configured$" "$configured_log" ||
+        fail "configured log did not receive rpm output"
+    rpm_state_check "a" ""
+
+    cat > "$wrapper" <<EOF
+#!/bin/sh
+printf 'overridden\n'
+exec "$(command -v rpm)" "\$@"
+EOF
+    chmod +x "$wrapper"
+
+    build b 1-1
+    $POLDEK --conf "$conf" --log "$cli_log" --cachedir "$CACHEDIR" \
+        -Ouse_sudo=$use_sudo -Odependency_solver=$DEPENDENCY_SOLVER \
+        -Oupgrade_multiple_instances=y --noask \
+        --st dir -s "$REPO" --root "$DESTINATION_REPO" --justdb \
+        --pmcmd "$wrapper" -uv b
+    assertEquals "install with CLI log failed" "0" "$?"
+    grep -q " rpm: overridden$" "$cli_log" ||
+        fail "CLI log did not receive rpm output"
+    if grep -q " rpm: overridden$" "$configured_log"; then
+        fail "CLI log did not override configured log"
+    fi
+    rpm_state_check "b" ""
+
+    cat > "$wrapper" <<EOF
+#!/bin/sh
+printf 'noconf\n'
+exec "$(command -v rpm)" "\$@"
+EOF
+    chmod +x "$wrapper"
+
+    build c 1-1
+    $POLDEK --noconf --conf "$conf" --cachedir "$CACHEDIR" \
+        -Ouse_sudo=$use_sudo -Odependency_solver=$DEPENDENCY_SOLVER \
+        -Oupgrade_multiple_instances=y --noask \
+        --st dir -s "$REPO" --root "$DESTINATION_REPO" --justdb \
+        --pmcmd "$wrapper" -uv c
+    assertEquals "install with --noconf failed" "0" "$?"
+    if grep -q " rpm: noconf$" "$configured_log"; then
+        fail "--noconf did not ignore the configured log"
+    fi
+    rpm_state_check "c" ""
+}
+
